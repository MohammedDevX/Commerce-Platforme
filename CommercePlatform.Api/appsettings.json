{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "LocalImageStorage": {
    "RootPath": "Uploads"
  },
  "ImageUploadRules": {
    "AllowedExtensions": [ "image/jpeg", "image/webp" ],
    "MaxSize": 1000000 // 1mb
  }
}
